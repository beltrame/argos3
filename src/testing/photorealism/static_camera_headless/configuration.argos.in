<?xml version="1.0" ?>
<argos-configuration>

  <!-- ************************* -->
  <!-- * General configuration * -->
  <!-- ************************* -->
  <framework>
    <system threads="0" />
    <experiment length="1" ticks_per_second="10" random_seed="123" />
  </framework>

  <!-- *************** -->
  <!-- * Controllers * -->
  <!-- *************** -->
  <controllers />

  <!-- ****************** -->
  <!-- * Loop functions * -->
  <!-- ****************** -->
  <loop_functions library="@CMAKE_CURRENT_BINARY_DIR@/libphotorealism_test_loop_functions"
                  label="photorealism_test_loop_functions" />

  <!-- *********************** -->
  <!-- * Arena configuration * -->
  <!-- *********************** -->
  <arena size="4, 4, 2" center="0,0,1">
    <box id="moving_box" size="0.3,0.3,0.3" movable="true" mass="1">
      <body position="0.8,0,0" orientation="0,0,0" />
    </box>
    <box id="wall_north" size="3,0.1,0.4" movable="false">
      <body position="0,1.5,0" orientation="0,0,0" />
    </box>
    <box id="wall_west" size="0.1,3,0.4" movable="false">
      <body position="-1.5,0,0" orientation="0,0,0" />
    </box>
    <cylinder id="pillar" radius="0.15" height="0.6" movable="false">
      <body position="-0.6,-0.6,0" orientation="0,0,0" />
    </cylinder>
    <cylinder id="pillar2" radius="0.1" height="1.0" movable="false">
      <body position="0.6,-0.8,0" orientation="0,0,0" />
    </cylinder>
  </arena>

  <!-- ******************* -->
  <!-- * Physics engines * -->
  <!-- ******************* -->
  <physics_engines>
    <dynamics2d id="dyn2d" />
  </physics_engines>

  <!-- ********* -->
  <!-- * Media * -->
  <!-- ********* -->
  <media>
    <photorealism id="pr" backend="vulkan">
      <sun direction="0.6,0.2,-1" intensity="100000" cast_shadows="true" />
      <skybox color="0.53,0.71,0.92" />
      <debug_camera position="2.5,2.5,2" look_at="0,0,0.2" fov="45"
                    resolution="640,480" period="1" dump="frames" />
    </photorealism>
  </media>

  <!-- No visualization: this test must run fully headless -->

</argos-configuration>
