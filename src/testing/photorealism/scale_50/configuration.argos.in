<?xml version="1.0" ?>
<argos-configuration>

  <framework>
    <system threads="0" />
    <experiment length="10" ticks_per_second="10" random_seed="42" />
  </framework>

  <controllers>
    <camera_test_controller library="@CAMERA_TEST_CONTROLLER_LIB@"
                            id="ctc">
      <actuators />
      <sensors>
        <photorealistic_camera implementation="default" medium="pr"
                               anchor="origin" position="0.1,0,0.15"
                               orientation="0,0,0" resolution="128,128"
                               fov="60" near="0.05" far="20"
                               modalities="rgb,depth,seg" />
      </sensors>
      <params expected_size="128,128" />
    </camera_test_controller>
  </controllers>

  <loop_functions library="@CMAKE_CURRENT_BINARY_DIR@/libscale_50_loop_functions"
                  label="scale_50_loop_functions" />

  <arena size="10, 10, 2" center="0,0,1">
    <box id="box_1" size="0.4,0.4,0.4" movable="false">
      <body position="4,4,0" orientation="30,0,0" />
    </box>
    <box id="box_2" size="0.3,0.6,0.5" movable="false">
      <body position="-4,3.5,0" orientation="-15,0,0" />
    </box>
    <cylinder id="cyl_1" radius="0.2" height="0.5" movable="false">
      <body position="3.8,-3.8,0" orientation="0,0,0" />
    </cylinder>
    <cylinder id="cyl_2" radius="0.3" height="0.3" movable="false">
      <body position="-4,-3.5,0" orientation="0,0,0" />
    </cylinder>
    <distribute>
      <position method="grid" center="0,0,0"
                distances="0.9,0.9,0" layout="8,7,1" />
      <orientation method="uniform" min="0,0,0" max="360,0,0" />
      <entity quantity="50" max_trials="1">
        <foot-bot id="fb">
          <controller config="ctc" />
        </foot-bot>
      </entity>
    </distribute>
  </arena>

  <physics_engines>
    <dynamics2d id="dyn2d" />
  </physics_engines>

  <media>
    <led id="leds" index="grid" grid_size="5,5,3" />
    <photorealism id="pr" backend="vulkan" stats="true">
      <sun direction="0.6,0.2,-1" intensity="100000" cast_shadows="true" />
      <skybox color="0.53,0.71,0.92" />
    </photorealism>
  </media>

  <!-- No visualization: this test must run fully headless -->

</argos-configuration>
