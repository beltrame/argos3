<?xml version="1.0" ?>
<!-- Two movable boxes as robots 40 m apart, and the base station 40 m
     behind robot_0: base -> robot_1 has to relay through robot_0.
     CMake fills in @MESH_ATTRIBUTES@ for each test. -->
<argos-configuration>

  <framework>
    <system threads="0" />
    <experiment length="1" ticks_per_second="10" random_seed="7" />
  </framework>

  <controllers />

  <arena size="200,200,2" center="0,0,1">
    <box id="robot_0" size="0.2,0.2,0.2" movable="true" mass="1">
      <body position="0,0,0" orientation="0,0,0" />
    </box>
    <box id="robot_1" size="0.2,0.2,0.2" movable="true" mass="1">
      <body position="40,0,0" orientation="0,0,0" />
    </box>
  </arena>

  <physics_engines>
    <dynamics2d id="dyn2d" />
  </physics_engines>

  <media>
    <mesh_medium id="mesh" @MESH_ATTRIBUTES@ />
  </media>

</argos-configuration>
