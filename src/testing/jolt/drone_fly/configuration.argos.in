<?xml version="1.0" ?>
<argos-configuration>

  <framework>
    <system threads="0" />
    <experiment length="0" ticks_per_second="10" random_seed="33" />
  </framework>

  <controllers>
    <drone_fly_controller library="@CMAKE_CURRENT_BINARY_DIR@/libdrone_fly_jolt_controller"
                          id="dfc">
      <actuators>
        <drone_flight_system implementation="default" />
      </actuators>
      <sensors>
        <drone_flight_system implementation="default" />
      </sensors>
      <params />
    </drone_fly_controller>
  </controllers>

  <loop_functions library="@CMAKE_CURRENT_BINARY_DIR@/libdrone_fly_jolt_loop_functions"
                  label="drone_fly_loop_functions" />

  <arena size="10, 4, 3" center="4,0,1.5">
    <drone id="drone">
      <body position="0,0,0" orientation="0,0,0" />
      <controller config="dfc" />
    </drone>
  </arena>

  <physics_engines>
    <jolt id="jolt" iterations="10" threads="1">
      <floor height="0" />
      <gravity g="9.81" />
    </jolt>
  </physics_engines>

  <media />

  <!-- No visualization: this test must run fully headless -->

</argos-configuration>
