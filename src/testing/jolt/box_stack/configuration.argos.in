<?xml version="1.0" ?>
<argos-configuration>

  <framework>
    <system threads="0" />
    <experiment length="8" ticks_per_second="10" random_seed="17" />
  </framework>

  <controllers />

  <loop_functions library="@CMAKE_CURRENT_BINARY_DIR@/libbox_stack_loop_functions"
                  label="box_stack_loop_functions"
                  poses_file="@POSES_FILE@" />

  <arena size="4, 4, 3" center="0,0,1.5">
    <box id="stack_0" size="0.2,0.2,0.2" movable="true" mass="1">
      <body position="0,0,0" orientation="0,0,0" />
    </box>
    <box id="stack_1" size="0.2,0.2,0.2" movable="true" mass="1">
      <body position="0.015,0,0.2" orientation="10,0,0" />
    </box>
    <box id="stack_2" size="0.2,0.2,0.2" movable="true" mass="1">
      <body position="-0.01,0.012,0.4" orientation="-5,0,0" />
    </box>
    <cylinder id="roller" radius="0.1" height="0.2" movable="true" mass="0.5">
      <body position="0.5,0.5,0.3" orientation="0,0,0" />
    </cylinder>
  </arena>

  <physics_engines>
    <jolt id="jolt" iterations="10" threads="1">
      <floor height="0" />
      <gravity g="9.81" />
    </jolt>
  </physics_engines>

  <media />

  <!-- No visualization: this test must run fully headless -->

</argos-configuration>
