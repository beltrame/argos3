<?xml version="1.0" ?>
<argos-configuration>

  <!-- GENERATED by import_fuel_world.py from the Gazebo Fuel world
       "Urban Circuit Practice 01" (OpenRobotics); regenerate rather than edit.

       A stand-alone tour of the environment: no robots, only the
       scenery, its lights and the collision mesh. Run it from this
       directory:

           argos3 -c urban_circuit_practice_01.argos            interactive viewer
           argos3 -z -c urban_circuit_practice_01.argos         headless, dumps frames/

       Drop robots into the <arena> and give them photorealistic_camera
       or photorealistic_lidar sensors on medium "pr" to use it in an
       experiment. The camera starts under the first lamp; the world's
       first placement, "staging_area", is at 0,0,0 (SDF frame) and
       every placement is listed in urban_circuit_practice_01.json. -->

  <framework>
    <system threads="0" />
    <experiment length="0" ticks_per_second="10" random_seed="1" />
  </framework>

  <controllers />

  <arena size="302.2,263.4,59.1" center="-0.8,-84.2,-1.5">
    <!-- Physics: every SDF <collision> of the world, as one static
         triangle mesh. y_up is the default: the file is glTF y-up. -->
    <mesh id="world" file="urban_circuit_practice_01.collision.glb" />
  </arena>

  <physics_engines>
    <jolt id="jolt">
      <gravity g="9.81" />
    </jolt>
  </physics_engines>

  <media>
    <!-- draw_floor="false": the ground is the tiles' own floors, not
         the ARGoS plane (which would cut through the lower levels). -->
    <photorealism id="pr" backend="vulkan" draw_floor="false">
      <!-- Underground: no sun, black sky. The SDF scene has
           ambient 0.1 and background black; here the tiles are lit by
           their own lamps only. -->
      <sun direction="0,0,-1" intensity="0" cast_shadows="false" />
      <skybox color="0,0,0" />
      <!-- Lamp-lit interior: opened up 10 stops from sunny 16. -->
      <exposure aperture="2.0" shutter_speed="0.04" sensitivity="400" />
      <lights>
        <!-- Most of these worlds are dark away from the few lit tiles,
             as in the competition, where robots carried their own
             lamps. A light with entity="<robot id>" is a headlight
             mounted on that robot (position and direction in its body
             frame, +x forward), e.g. for a spot or a bunker:
             <spot entity="sp0" position="0.45,0,0.2" direction="1,0,-0.15"
                   intensity="3000" falloff="25" inner_angle="20"
                   outer_angle="35" color="1.0,0.95,0.85" /> -->
        <!-- 35 SDF lights, world frame; 40000 lm for a 20 m
             range, scaled with range squared -->
        <!-- tile_1/light1/spot_light1 -->
        <spot position="-94,-18.5,5.8" direction="0,0,-1" intensity="40000" falloff="20" color="0.8,0.8,0.8" inner_angle="57.3" outer_angle="88.8" />
        <!-- tile_1/light2/spot_light2 -->
        <spot position="-95,-5.5,5.8" direction="0,0,-1" intensity="40000" falloff="20" color="0.8,0.8,0.8" inner_angle="57.3" outer_angle="88.8" />
        <!-- tile_3/lights/spot_light1 -->
        <spot position="-23.2,-31.4,8.8" direction="0,0,-1" intensity="40000" falloff="20" color="0.8,0.8,0.8" inner_angle="57.3" outer_angle="88.8" />
        <!-- tile_3/lights/spot_light2 -->
        <spot position="-8.8,-31.4,8.8" direction="0,0,-1" intensity="40000" falloff="20" color="0.8,0.8,0.8" inner_angle="57.3" outer_angle="88.8" />
        <!-- tile_3/lights/spot_light3 -->
        <spot position="-23.2,-18.4,8.8" direction="0,0,-1" intensity="40000" falloff="20" color="0.8,0.8,0.8" inner_angle="57.3" outer_angle="88.8" />
        <!-- tile_4/light1/spot_light1 -->
        <spot position="26.5,-14,5.8" direction="0,0,-1" intensity="40000" falloff="20" color="0.8,0.8,0.8" inner_angle="57.3" outer_angle="88.8" />
        <!-- tile_4/light2/spot_light2 -->
        <spot position="13.5,-15,5.8" direction="0,0,-1" intensity="40000" falloff="20" color="0.8,0.8,0.8" inner_angle="57.3" outer_angle="88.8" />
        <!-- tile_5/light1/downstairs_1 -->
        <spot position="64,-16,8.4" direction="0,-1,0" intensity="250000" falloff="50" color="0.5,0.5,0.5" inner_angle="57.3" outer_angle="85.9" />
        <!-- tile_5/light1/upstairs_1 -->
        <spot position="61.4,-23.2,18.4" direction="0,-1,0" intensity="250000" falloff="50" color="0.5,0.5,0.5" inner_angle="57.3" outer_angle="85.9" />
        <!-- tile_5/light1/upstairs_2 -->
        <spot position="74.7,-16,18.4" direction="0,-1,0" intensity="250000" falloff="50" color="0.5,0.5,0.5" inner_angle="57.3" outer_angle="85.9" />
        <!-- tile_5/light1/upstairs_3 -->
        <spot position="74.7,-1.2,18.4" direction="0,-1,0" intensity="250000" falloff="50" color="0.5,0.5,0.5" inner_angle="57.3" outer_angle="85.9" />
        <!-- tile_8/light1/downstairs_1 -->
        <spot position="-96,-56,-1.6" direction="0,-1,0" intensity="250000" falloff="50" color="0.5,0.5,0.5" inner_angle="57.3" outer_angle="85.9" />
        <!-- tile_8/light1/upstairs_1 -->
        <spot position="-98.6,-63.2,8.4" direction="0,-1,0" intensity="250000" falloff="50" color="0.5,0.5,0.5" inner_angle="57.3" outer_angle="85.9" />
        <!-- tile_8/light1/upstairs_2 -->
        <spot position="-85.3,-56,8.4" direction="0,-1,0" intensity="250000" falloff="50" color="0.5,0.5,0.5" inner_angle="57.3" outer_angle="85.9" />
        <!-- tile_8/light1/upstairs_3 -->
        <spot position="-85.3,-41.2,8.4" direction="0,-1,0" intensity="250000" falloff="50" color="0.5,0.5,0.5" inner_angle="57.3" outer_angle="85.9" />
        <!-- tile_11/lights/spot_light1 -->
        <spot position="-8.8,-40.6,8.8" direction="0,0,-1" intensity="40000" falloff="20" color="0.8,0.8,0.8" inner_angle="57.3" outer_angle="88.8" />
        <!-- tile_11/lights/spot_light2 -->
        <spot position="-23.2,-40.6,8.8" direction="0,0,-1" intensity="40000" falloff="20" color="0.8,0.8,0.8" inner_angle="57.3" outer_angle="88.8" />
        <!-- tile_11/lights/spot_light3 -->
        <spot position="-8.8,-53.6,8.8" direction="0,0,-1" intensity="40000" falloff="20" color="0.8,0.8,0.8" inner_angle="57.3" outer_angle="88.8" />
        <!-- tile_14/light/stairwell_1 -->
        <spot position="-18.1,-91.1,2.4" direction="0,0,-1" intensity="40000" falloff="20" color="0.8,0.8,0.8" inner_angle="57.3" outer_angle="88.8" />
        <!-- tile_14/light/stairwell_2 -->
        <spot position="-17.5,-110.1,-2.6" direction="0,0,-1" intensity="40000" falloff="20" color="0.8,0.8,0.8" inner_angle="57.3" outer_angle="88.8" />
        <!-- tile_14/light/spot_1 -->
        <spot position="-35.1,-91.6,3" direction="0,0,-1" intensity="40000" falloff="20" color="0.8,0.8,0.8" inner_angle="57.3" outer_angle="88.8" />
        <!-- tile_14/light/spot_2 -->
        <spot position="-47.7,-112.5,0" direction="0,0,-1" intensity="40000" falloff="20" color="0.8,0.8,0.8" inner_angle="57.3" outer_angle="88.8" />
        <!-- tile_15/light1/downstairs1 -->
        <spot position="71.3,-80.9,9.2" direction="0,0,-1" intensity="40000" falloff="20" color="0.8,0.8,0.8" inner_angle="57.3" outer_angle="88.8" />
        <!-- tile_15/light1/downstairs2 -->
        <spot position="49.7,-93.9,9.2" direction="0,0,-1" intensity="40000" falloff="20" color="0.8,0.8,0.8" inner_angle="57.3" outer_angle="88.8" />
        <!-- tile_15/light1/upstairs1 -->
        <spot position="71.3,-93.9,19.2" direction="0,0,-1" intensity="40000" falloff="20" color="0.8,0.8,0.8" inner_angle="57.3" outer_angle="88.8" />
        <!-- tile_15/light1/upstairs2 -->
        <spot position="49.7,-80.9,19.2" direction="0,0,-1" intensity="40000" falloff="20" color="0.8,0.8,0.8" inner_angle="57.3" outer_angle="88.8" />
        <!-- tile_21/lights/tunnel1 -->
        <spot position="61.4,-137.6,15.2" direction="0,0,-1" intensity="40000" falloff="20" color="0.8,0.8,0.8" inner_angle="57.3" outer_angle="88.8" />
        <!-- tile_21/lights/tunnel2 -->
        <spot position="76.5,-137.6,15.2" direction="0,0,-1" intensity="40000" falloff="20" color="0.8,0.8,0.8" inner_angle="57.3" outer_angle="88.8" />
        <!-- tile_21/lights/door1 -->
        <spot position="64,-125.1,16" direction="0,0,-1" intensity="40000" falloff="20" color="0.8,0.8,0.8" inner_angle="57.3" outer_angle="88.8" />
        <!-- tile_28/lights/tunnel1 -->
        <spot position="2.2,-176,-3.2" direction="0,0,-1" intensity="40000" falloff="20" color="0.8,0.8,0.8" inner_angle="57.3" outer_angle="88.8" />
        <!-- tile_28/lights/tunnel2 -->
        <spot position="-10.5,-176,-3.2" direction="0,0,-1" intensity="40000" falloff="20" color="0.8,0.8,0.8" inner_angle="57.3" outer_angle="88.8" />
        <!-- tile_28/lights/tunnel3 -->
        <spot position="-28.4,-177.38,-4.9" direction="0,0,-1" intensity="40000" falloff="20" color="0.8,0.8,0.8" inner_angle="57.3" outer_angle="88.8" />
        <!-- tile_29/lights/spot_light1 -->
        <spot position="-5.72,-204.5,-4.2" direction="0,0,-1" intensity="40000" falloff="20" color="0.8,0.8,0.8" inner_angle="57.3" outer_angle="88.8" cast_shadows="true" />
        <!-- tile_29/lights/spot_light2 -->
        <spot position="8.9,-194.8,-4.2" direction="0,0,-1" intensity="40000" falloff="20" color="0.8,0.8,0.8" inner_angle="57.3" outer_angle="88.8" cast_shadows="true" />
        <!-- tile_29/lights/spot_light3 -->
        <spot position="8,-208.3,-4.2" direction="0,0,-1" intensity="40000" falloff="20" color="0.8,0.8,0.8" inner_angle="57.3" outer_angle="88.8" cast_shadows="true" />
      </lights>
      <scenery>
        <!-- Every SDF <visual>, y-up glTF hence orientation 0,0,90 -->
        <prop model="urban_circuit_practice_01.glb" position="0,0,0" orientation="0,0,90" scale="1" />
      </scenery>
      <debug_camera position="-94,-18.5,2.6" look_at="-95,-5.5,2.2" fov="70"
                    resolution="960,540" period="10" dump="frames" />
    </photorealism>
  </media>

  <visualization>
    <!-- The flashlight (F toggles) rides on the free-fly camera and is
         seen by this window only, never by robot sensors: most of the
         map is unlit. -->
    <filament medium="pr" resolution="1280,720" speed="1"
              near="0.1" far="300" flashlight="true"
              position="-94,-18.5,2.6" look_at="-95,-5.5,2.2" />
  </visualization>

</argos-configuration>
