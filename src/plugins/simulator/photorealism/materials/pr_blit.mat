material {
    name : pr_blit,
    shadingModel : unlit,
    culling : none,
    depthWrite : false,
    depthCulling : false,
    requires : [ uv0 ],
    parameters : [
        {
            type : sampler2d,
            name : tex
        }
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        /* The camera textures are sampled v-flipped so that the
           atlas readback rows come out top-to-bottom */
        float2 uv = getUV0();
        material.baseColor = texture(materialParams_tex,
                                     float2(uv.x, 1.0 - uv.y));
    }
}
